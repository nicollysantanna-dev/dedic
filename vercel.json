{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "functions": {
    "api/hevy-sync.ts": { "maxDuration": 60 },
    "api/hevy-sync-cron.ts": { "maxDuration": 60 }
  },
  "crons": [{ "path": "/api/hevy-sync-cron", "schedule": "0 1 * * *" }]
}
